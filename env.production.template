# Production Environment Variables Template
# Copy this file to .env.production and fill in your values
# Command: cp env.production.template .env.production

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://your-domain.com

# ============================================
# DATABASE
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/click

# Or MongoDB Atlas (recommended for production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/click?retryWrites=true&w=majority

# ============================================
# SECURITY
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=30d
# Encrypts stored social OAuth tokens. REQUIRED in production (32+ characters).
# Left blank on purpose so a deploy that forgets it fails loudly.
OAUTH_ENCRYPTION_KEY=
# Signed media: /uploads is only reachable through short-lived HMAC-signed URLs.
# MEDIA_URL_SECRET falls back to JWT_SECRET when unset; a dedicated one is better.
MEDIA_URL_SECRET=
REQUIRE_SIGNED_MEDIA=true
# OAuth code exchange server-side (keeps ?code= out of browser history). OFF by
# default — enable only after a staging rehearsal with real platform credentials.
# OAUTH_SERVER_SIDE_EXCHANGE=false

# ============================================
# AWS S3 STORAGE (Optional but Recommended)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# ============================================
# REDIS CACHING (Optional but Recommended)
# ============================================
# Local Redis
REDIS_URL=redis://localhost:6379

# Or Redis Cloud
# REDIS_URL=redis://username:password@redis-host:6379

# ============================================
# MONITORING & ERROR TRACKING
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# OAUTH - TWITTER/X
# ============================================
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_CALLBACK_URL=https://your-domain.com/api/oauth/twitter/callback

# ============================================
# OAUTH - LINKEDIN
# ============================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=https://your-domain.com/api/oauth/linkedin/callback

# ============================================
# OAUTH - FACEBOOK (also used for Instagram)
# ============================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/oauth/facebook/callback

# ============================================
# OAUTH - YOUTUBE
# ============================================
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_CALLBACK_URL=https://your-domain.com/api/oauth/youtube/callback

# ============================================
# OAUTH - TIKTOK
# ============================================
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_CALLBACK_URL=https://your-domain.com/api/oauth/tiktok/callback

# ============================================
# EMAIL (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# ============================================
# AI MODELS - GOOGLE GEMINI (Primary)
# ============================================
# Powers the AI features. Use a key from a Google Cloud project with BILLING
# enabled — the free tier's small daily request quota runs out quickly, after
# which AI features answer "unavailable". https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ============================================
# AI MODELS - OPENAI / ANTHROPIC (fallbacks)
# ============================================
# server/utils/aiRouter.js falls back Gemini -> OpenAI -> Anthropic.
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=
# Reserve estimated AI cost atomically before each call. ON by default.
# AI_BUDGET_ATOMIC_RESERVE=true

# ============================================
# AI MODELS - FREE ALTERNATIVES (Optional)
# ============================================
# OpenRouter (50 free requests/day, no key required for free models)
OPENROUTER_API_KEY=your-openrouter-key-optional

# Hugging Face (1000 free requests/day)
HUGGINGFACE_API_KEY=your-huggingface-key-optional

# Cerebras (1M tokens/day free, no key required)
CEREBRAS_API_KEY=your-cerebras-key-optional

# Replicate ($5 free credits for new users)
REPLICATE_API_KEY=your-replicate-key-optional

# ============================================
# WHOP (subscriptions + billing)
# ============================================
# WHOP_API_KEY is required to issue refunds from the self-serve cancellation
# flow. Without it a refund stays in 'failed' with a reason for manual action in
# the Whop dashboard — it is never reported to the customer as processed.
WHOP_API_KEY=your-whop-api-key
WHOP_API_URL=https://api.whop.com/api/v2
# Verifies inbound webhooks. Paid tiers are granted ONLY by a signed webhook.
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
# Each plan's product_id from the Whop dashboard — maps a payment to a tier.
WHOP_PRODUCT_ID_CREATOR_MONTHLY=
WHOP_PRODUCT_ID_CREATOR_YEARLY=
WHOP_PRODUCT_ID_PRO_MONTHLY=
WHOP_PRODUCT_ID_PRO_YEARLY=
WHOP_PRODUCT_ID_AGENCY_MONTHLY=
WHOP_PRODUCT_ID_AGENCY_YEARLY=
# Drops out-of-order webhook deliveries. ON by default.
# WHOP_WEBHOOK_ORDERING_GUARD=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_CACHING=true
ENABLE_FREE_AI_MODELS=true

# ============================================
# SUPABASE (auth + Postgres) — REQUIRED IN PRODUCTION
# ============================================
# Previously missing from this template, so a deploy that followed it alone got
# a server that booted fine but with degraded /api/health, non-functional admin
# routes, broken Google/Instagram OAuth token exchange, and no platform
# analytics ingestion. Nothing crashes — the features just stop working.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# OPS ALERTING (optional)
# ============================================
# Unset = operational alerts are computed and then silently dropped.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
